{
  "name": "popcorn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "extension:local": "node scripts/build-local-extension.mjs",
    "extension:package": "bash scripts/package-extension.sh",
    "popcorn:start": "node scripts/popcorn-local.mjs start",
    "popcorn:stop": "node scripts/popcorn-local.mjs stop",
    "worker:local": "node scripts/process-local-jobs.mjs",
    "build": "next build --webpack",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:contract && pnpm test:integration",
    "test:unit": "vitest run src --passWithNoTests",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:provenance": "vitest run tests/provenance --passWithNoTests",
    "test:extension": "node --test --test-name-pattern='^(?:notes filters preserve selected contrast and expose pressed state|runtime has no source-file credential dependency or retired model|retired Remix and reader files are absent|published prompt files contain runtime sections)$' extension/tests/release.test.js",
    "test:e2e": "playwright test --pass-with-no-tests",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:provenance && pnpm build",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.3.1",
    "openai": "^6.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^28.1.0",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.19.0"
}
