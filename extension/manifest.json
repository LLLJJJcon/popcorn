{
  "manifest_version": 3,
  "name": "Popcorn",
  "version": "1.1.5",
  "key": "",
  "minimum_chrome_version": "116",
  "description": "Save useful Chinese YouTube moments to your Popcorn account.",
  "permissions": ["sidePanel", "storage", "tabs", "scripting", "identity", "alarms"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://app.popcorn.local/*",
    "https://project.supabase.co/*"
  ],
  "action": {
    "default_title": "Open Popcorn",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
