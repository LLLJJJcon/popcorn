# Public local URLs and browser-safe Supabase configuration.
APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Keep these out of the extension, browser, and Git.
SUPABASE_SERVICE_ROLE_KEY=
SUPADATA_API_KEY=
INTERNAL_JOB_SECRET=

# The user model gateway credential is deliberately absent here. Enter the
# gateway name, HTTPS base URL, model, and write-only API key in Web settings.
